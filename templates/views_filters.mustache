{{!
    @template local_notice/views_filters

    Search and filters for the "Who saw" report. Submitted with GET so the
    filtered list can be bookmarked and paginated.

    Example context (json):
    {
        "action": "https://example.com/local/notice/views.php",
        "id": 1,
        "search": "maria",
        "statuses": [{"value": "seen", "label": "Users who saw it", "selected": true}],
        "datefrom": "2026-11-01",
        "dateto": "",
        "accessfiltersdisabled": false,
        "closemethods": [{"value": "", "label": "Any", "selected": true}],
        "perpageoptions": [{"value": 50, "label": 50, "selected": true}],
        "hasfilters": true,
        "reseturl": "https://example.com/local/notice/views.php?id=1"
    }
}}
<form method="get" action="{{action}}" class="local-notice-filters card card-body mb-3" role="search">
    <input type="hidden" name="id" value="{{id}}">
    <div class="local-notice-filter local-notice-filter-search">
        <label for="local-notice-search" class="form-label">{{#str}}search, local_notice{{/str}}</label>
        <input type="search" id="local-notice-search" name="search" value="{{search}}" class="form-control"
            placeholder="{{#str}}search_placeholder, local_notice{{/str}}">
    </div>
    <div class="local-notice-filter">
        <label for="local-notice-status" class="form-label">{{#str}}filterstatus, local_notice{{/str}}</label>
        <select id="local-notice-status" name="status" class="form-select custom-select">
            {{#statuses}}
            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
            {{/statuses}}
        </select>
    </div>
    <div class="local-notice-filter">
        <label for="local-notice-datefrom" class="form-label">{{#str}}datefrom, local_notice{{/str}}</label>
        <input type="date" id="local-notice-datefrom" name="datefrom" value="{{datefrom}}" class="form-control"
            {{#accessfiltersdisabled}}disabled{{/accessfiltersdisabled}}>
    </div>
    <div class="local-notice-filter">
        <label for="local-notice-dateto" class="form-label">{{#str}}dateto, local_notice{{/str}}</label>
        <input type="date" id="local-notice-dateto" name="dateto" value="{{dateto}}" class="form-control"
            {{#accessfiltersdisabled}}disabled{{/accessfiltersdisabled}}>
    </div>
    <div class="local-notice-filter">
        <label for="local-notice-closemethod" class="form-label">{{#str}}closemethod, local_notice{{/str}}</label>
        <select id="local-notice-closemethod" name="closemethod" class="form-select custom-select"
            {{#accessfiltersdisabled}}disabled{{/accessfiltersdisabled}}>
            {{#closemethods}}
            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
            {{/closemethods}}
        </select>
    </div>
    <div class="local-notice-filter">
        <label for="local-notice-perpage" class="form-label">{{#str}}perpage, local_notice{{/str}}</label>
        <select id="local-notice-perpage" name="perpage" class="form-select custom-select">
            {{#perpageoptions}}
            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
            {{/perpageoptions}}
        </select>
    </div>
    <div class="local-notice-filter local-notice-filter-buttons">
        <button type="submit" class="btn btn-primary">{{#str}}filter, local_notice{{/str}}</button>
        {{#hasfilters}}
        <a href="{{reseturl}}" class="btn btn-secondary">{{#str}}clearfilters, local_notice{{/str}}</a>
        {{/hasfilters}}
    </div>
</form>
