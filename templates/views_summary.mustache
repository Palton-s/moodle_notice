{{!
    @template local_notice/views_summary

    How many active users saw a notice.

    Example context (json):
    {
        "text": "120 of 480 active users saw this notice (25%). 360 have not seen it yet.",
        "percent": 25,
        "percentcss": "25"
    }
}}
<div class="local-notice-summary mb-3">
    <p class="mb-1">{{text}}</p>
    <div class="progress" role="progressbar" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar bg-success" style="width: {{percentcss}}%"></div>
    </div>
</div>
