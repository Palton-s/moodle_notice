{{!
    @template local_notice/notices

    Hidden holder for pending notices. The content of each <template> is inert
    (images/videos don't load) until the JS module shows it in a modal.

    Context variables required for this template:
    * preview - bool, when true dismissing does not record anything
    * notices - array of notices: id, title, content (HTML), buttonlabel

    Example context (json):
    {
        "preview": false,
        "notices": [
            {"id": 1, "title": "Welcome", "content": "<p>Hello <b>world</b></p>", "buttonlabel": "Got it"}
        ]
    }
}}
<div class="local-notice-container d-none" data-preview="{{#preview}}1{{/preview}}{{^preview}}0{{/preview}}" aria-hidden="true">
    {{#notices}}
    <template class="local-notice-item" data-id="{{id}}" data-title="{{title}}" data-button="{{buttonlabel}}">
        <div class="local-notice-content">{{{content}}}</div>
    </template>
    {{/notices}}
</div>
